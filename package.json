{
  "name": "be-kvetching",
  "version": "0.0.5",
  "description": "Turns the tag it adorns into a web component that inherits from [k-fetch](https://github.com/bahrus/k-fetch)",
  "keywords": [
    "web-components",
    "web-component",
    "custom-element",
    "custom-elements",
    "JSON",
    "bind",
    "observe"
  ],
  "main": "be-kvetching.js",
  "module": "be-kvetching.js",
  "exports": {
    ".": "./be-kvetching.js",
    "./behivior": "./behivior.js",
    "./be-kvetching.js": "./be-kvetching.js"
  },
  "files": [
    "*.js",
    "types.d.ts"
  ],
  "types": "types.d.ts",
  "dependencies": {
    "be-enhanced": "0.0.188",
    "be-hive": "0.0.266",
    "k-fetch": "0.0.13",
    "trans-render": "0.0.958"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "spa-ssi": "0.0.10"
  },
  "scripts": {
    "serve": "node ./node_modules/spa-ssi/serve.js",
    "test": "playwright test",
    "safari": "npx playwright wk http://localhost:8000",
    "update": "ncu -u && npm install"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bahrus/be-kvetching.git"
  },
  "author": "anderson.bruce.b@gmail.com",
  "license": "MIT"
}
